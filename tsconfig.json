{
	"extends": "./.hutch/devkit/tsconfig.json",
	"compilerOptions": {
		"target": "ESNext",
		"useDefineForClassFields": true,
		"module": "ESNext",
		"resolveJsonModule": true,
		"allowJs": true,
		"isolatedModules": true,
		"moduleDetection": "force",
		"noEmit": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"moduleResolution": "bundler",
		"skipLibCheck": true,
		"jsx": "react-jsx",
		"baseUrl": ".",
		"paths": {
			"@/*": [
				"./src/mainview/src/*"
			],
			"electrobun": [
				"./.hutch/devkit/api/sdks/main/index.ts"
			],
			"electrobun/main": [
				"./.hutch/devkit/api/sdks/main/index.ts"
			],
			"electrobun/view": [
				"./.hutch/devkit/api/browser/index.ts"
			]
		}
	},
	"include": [
		"src"
	],
	"exclude": [
		"node_modules",
		"dist",
		"build",
		"../../package/dist"
	]
}